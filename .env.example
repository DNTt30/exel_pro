# Prisma + Supabase (KHÔNG commit file .env)
# Dashboard → Project Settings → Database
# User khuyến nghị: prisma (xem sql_prisma_user.sql), không dùng postgres trên production.

# Migrate / db pull — Direct connection, port 5432
DIRECT_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# App runtime — Transaction pooler, port 6543 + pgbouncer (tránh lỗi prepared statement)
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
