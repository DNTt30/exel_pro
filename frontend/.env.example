# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit .env vào git

# ============================
# Supabase (bắt buộc)
# ============================
# Lấy tại: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================
# Tính năng tùy chọn
# ============================
# Edge Function reset-password (admin đặt lại mật khẩu NV)
# VITE_ADMIN_OTP_URL=https://your-project.supabase.co/functions/v1/admin-otp

# Gemini AI (AI Copilot xếp lịch)
# VITE_GEMINI_API_KEY=your-gemini-key-here

# Telegram Bot (thông báo login, duyệt lịch)
# VITE_TELEGRAM_BOT_TOKEN=your-bot-token
# VITE_TELEGRAM_CHAT_ID=your-chat-id
