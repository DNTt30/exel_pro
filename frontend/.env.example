# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit .env vào git

# ============================
# Supabase (bắt buộc)
# ============================
# Lấy tại: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================
# Tính năng tùy chọn
# ============================
# Edge Function reset-password (admin đặt lại mật khẩu NV)
# VITE_ADMIN_OTP_URL=https://your-project.supabase.co/functions/v1/admin-otp
# Optional override; otherwise derived from VITE_SUPABASE_URL. No email/Telegram secrets in Vite.
# VITE_PASSWORD_RESET_URL=https://your-project.supabase.co/functions/v1/reset-password

# Gemini, Resend, Jev và Telegram: đặt secret trong Supabase Edge Functions.
# Không đưa API key, bot token hoặc proxy shared secret vào bất kỳ VITE_* nào.

# Prefer the authenticated Edge proxy; keep bot token in Supabase secrets.
# VITE_TELEGRAM_PROXY_URL=https://your-project.supabase.co/functions/v1/telegram-notify

# Jev: optional, disabled until configured. Never put TYPESAFE_API_KEY here.
# Changing VITE_ flags requires rebuilding the frontend.
# VITE_JEV_FN_URL=https://your-project.supabase.co/functions/v1/jev-decide
VITE_JEV_UC2=off
VITE_JEV_EXPERIMENTAL=off
VITE_JEV_SWAPS=off
VITE_JEV_AGENTS=off
