generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Studio / migrate: session mode port 5432. Không dùng 6543+pgbouncer (engine rỗng).
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

