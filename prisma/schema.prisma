/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admin_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id   String?
  actor_name String?
  action     String
  target     String?
  detail     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model employees {
  id         String      @id @db.VarChar(20)
  name       String
  dept       String      @db.VarChar(50)
  type       String?     @db.VarChar(50)
  role       String?     @db.VarChar(50)
  max_h      Int?        @default(48)
  created_at DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  schedules  schedules[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model feedbacks {
  id         String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  emp_id     String   @db.VarChar(20)
  name       String
  dept       String   @db.VarChar(50)
  date       String   @db.VarChar(20)
  shift      String   @db.VarChar(50)
  hours      Int
  reason     String?
  status     String?  @default("pending") @db.VarChar(20)
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id            String    @id @db.Uuid
  employee_code String    @unique @db.VarChar(20)
  full_name     String    @db.VarChar(100)
  department    String?   @db.VarChar(100)
  role          user_role @default(EMPLOYEE)
  avatar_url    String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model schedule_weeks {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id     String
  week_date    DateTime  @db.Date
  status       String    @default("draft")
  submitted_by String?
  submitted_at DateTime? @db.Timestamptz(6)
  reviewed_by  String?
  reviewed_at  DateTime? @db.Timestamptz(6)
  review_note  String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([store_id, week_date])
  @@index([store_id, week_date], map: "schedule_weeks_store_week_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model schedules {
  id         String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  week_date  String    @db.VarChar(20)
  emp_id     String    @db.VarChar(20)
  shifts     Json      @default("{}")
  created_at DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  employees  employees @relation(fields: [emp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([week_date, emp_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shelf_items {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shelf_id      String        @db.Uuid
  store_id      String
  product_name  String
  qty           Decimal?      @db.Decimal
  expiry_date   DateTime?     @db.Date
  note          String?
  updated_by    String?
  updated_at    DateTime?     @default(now()) @db.Timestamptz(6)
  store_shelves store_shelves @relation(fields: [shelf_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiry_date], map: "shelf_items_expiry_idx")
  @@index([shelf_id], map: "shelf_items_shelf_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shift_swaps {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week_date     String
  store         String?
  from_emp_id   String
  from_emp_name String?
  from_day      String
  from_shift    String?
  to_emp_id     String
  to_emp_name   String?
  to_day        String
  to_shift      String?
  reason        String?
  status        String    @default("pending_partner")
  manager_note  String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  resolved_at   DateTime? @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model store_shelves {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id    String
  code        String
  name        String?
  assignee_id String?
  notify_days Int?          @default(3)
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  shelf_items shelf_items[]

  @@unique([store_id, code])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stores {
  id         String   @id @db.VarChar(50)
  name       String
  region     String?  @default("Miền Bắc") @db.VarChar(50)
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  staffing   Json?    @default("{\"weekday\": {\"22-6\": 1, \"6-14\": 2, \"14-22\": 2}, \"weekend\": {\"22-6\": 1, \"6-14\": 2, \"14-22\": 2}}")

  @@schema("public")
}

enum aal_level {
  aal1
  aal2
  aal3

  @@schema("auth")
}

enum code_challenge_method {
  s256
  plain

  @@schema("auth")
}

enum factor_status {
  unverified
  verified

  @@schema("auth")
}

enum factor_type {
  totp
  webauthn
  phone

  @@schema("auth")
}

enum oauth_authorization_status {
  pending
  approved
  denied
  expired

  @@schema("auth")
}

enum oauth_client_type {
  public
  confidential

  @@schema("auth")
}

enum oauth_registration_type {
  dynamic
  manual

  @@schema("auth")
}

enum oauth_response_type {
  code

  @@schema("auth")
}

enum one_time_token_type {
  confirmation_token
  reauthentication_token
  recovery_token
  email_change_token_new
  email_change_token_current
  phone_change_token

  @@schema("auth")
}

enum user_role {
  ADMIN
  STORE_MANAGER
  EMPLOYEE

  @@schema("public")
}
